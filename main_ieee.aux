\newlabel{sec:holdall}{{V-C}{5}{Test 2, hold at every target}{subsection.5.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {X}{\ignorespaces Mann--Whitney $U$ test on the per-run packet-gap totals of the 20-minute holds (8 runs per backend). IQR = 25th to 75th percentile of the 8 run values. $U$ counts the run pairs in which the C++ server had more gaps than the ENet server (ties count half); $U=0$ means every ENet run had more gaps than every C++ run. The exact two-sided $p$ comes from all $C(16,8)=12{,}870$ ways to split the 16 run values into two groups.\relax }}{5}{table.caption.18}\protected@file@percent }
\newlabel{tab:mwu}{{X}{5}{Mann--Whitney $U$ test on the per-run packet-gap totals of the 20-minute holds (8 runs per backend). IQR = 25th to 75th percentile of the 8 run values. $U$ counts the run pairs in which the C++ server had more gaps than the ENet server (ties count half); $U=0$ means every ENet run had more gaps than every C++ run. The exact two-sided $p$ comes from all $C(16,8)=12{,}870$ ways to split the 16 run values into two groups.\relax }{table.caption.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Test 1, progressive ladder (granular batch, both patches applied; server on an e2-standard-2 VM, three n2-standard-4 client VMs, 10\nobreakspace  {}s per client count; the 1-client warm-up state and the last state, 300 clients, are left out: the last state has no later state to time it by, so its counters cover a longer period than 10\nobreakspace  {}s, see Section\nobreakspace  {}\ref  {sec:fixes}). Each line is the mean of 8 runs and the band spans the lowest to the highest run. The C++ server is driven by Godot UDP clients and the ENet server by Godot ENet clients. Ping is measured by the Godot client (time from its last send until a snapshot arrives), not a true round trip. Packet gaps are skipped snapshot numbers summed over all clients in a state. Dashed lines: 20 snapshots per second and the 18\nobreakspace  {}Hz tick threshold. Clients responding was 100\% in every state and the server tick rate stayed between 19.9 and 20.1\nobreakspace  {}Hz for both servers (Table\nobreakspace  {}\ref  {tab:ladder}), so those two panels are left out.\relax }}{6}{figure.caption.12}\protected@file@percent }
\newlabel{fig:ladder}{{6}{6}{Test 1, progressive ladder (granular batch, both patches applied; server on an e2-standard-2 VM, three n2-standard-4 client VMs, 10~s per client count; the 1-client warm-up state and the last state, 300 clients, are left out: the last state has no later state to time it by, so its counters cover a longer period than 10~s, see Section~\ref {sec:fixes}). Each line is the mean of 8 runs and the band spans the lowest to the highest run. The C++ server is driven by Godot UDP clients and the ENet server by Godot ENet clients. Ping is measured by the Godot client (time from its last send until a snapshot arrives), not a true round trip. Packet gaps are skipped snapshot numbers summed over all clients in a state. Dashed lines: 20 snapshots per second and the 18~Hz tick threshold. Clients responding was 100\% in every state and the server tick rate stayed between 19.9 and 20.1~Hz for both servers (Table~\ref {tab:ladder}), so those two panels are left out.\relax }{figure.caption.12}{}}
\@writefile{lot}{\contentsline {table}{\numberline {VII}{\ignorespaces Ladder results at selected client counts, summed up over 8 runs (10\nobreakspace  {}s per state). Ping, Snap/s and Gaps show the mean and, in brackets, the lowest and highest run. Resp.\ = clients responding (mean); Ping = the Godot client's ping proxy; Snap/s = snapshots received per client per second; Gaps = skipped snapshot numbers in that state; Tick = server ticks per second; Srv CPU = server CPU.\relax }}{6}{table.caption.13}\protected@file@percent }
\newlabel{tab:ladder}{{VII}{6}{Ladder results at selected client counts, summed up over 8 runs (10~s per state). Ping, Snap/s and Gaps show the mean and, in brackets, the lowest and highest run. Resp.\ = clients responding (mean); Ping = the Godot client's ping proxy; Snap/s = snapshots received per client per second; Gaps = skipped snapshot numbers in that state; Tick = server ticks per second; Srv CPU = server CPU.\relax }{table.caption.13}{}}
\@writefile{lot}{\contentsline {table}{\numberline {VIII}{\ignorespaces Per run, over the ladder (291 states, 1 and 10 to 299 clients): states that met the health limits, snapshot gaps summed over all states, and the first client count (from 10 upward) at which a state failed (-- = none).\relax }}{7}{table.caption.14}\protected@file@percent }
\newlabel{tab:limit}{{VIII}{7}{Per run, over the ladder (291 states, 1 and 10 to 299 clients): states that met the health limits, snapshot gaps summed over all states, and the first client count (from 10 upward) at which a state failed (-- = none).\relax }{table.caption.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Test 2, hold at 300 clients (server on an e2-standard-2 VM, three n2-standard-4 client VMs). The clients are added first (ramp-up, 10 clients every 10\nobreakspace  {}s) and the plot starts when the last client has joined; it then covers the 20-minute hold with no new clients. Each line is the median of 8 runs and the band spans the 25th to the 75th percentile. Packet gaps are skipped snapshot numbers summed over all clients in a 10\nobreakspace  {}s window. Ping is the Godot client's ping proxy, not a true round trip. Dashed lines: 20 snapshots per second and the 18\nobreakspace  {}Hz tick threshold. Clients responding was 100\% throughout and the median server tick rate stayed between 19.9 and 20.1\nobreakspace  {}Hz for both servers (Table\nobreakspace  {}\ref  {tab:holdsum}), so those two panels are left out.\relax }}{7}{figure.caption.15}\protected@file@percent }
\newlabel{fig:hold300}{{7}{7}{Test 2, hold at 300 clients (server on an e2-standard-2 VM, three n2-standard-4 client VMs). The clients are added first (ramp-up, 10 clients every 10~s) and the plot starts when the last client has joined; it then covers the 20-minute hold with no new clients. Each line is the median of 8 runs and the band spans the 25th to the 75th percentile. Packet gaps are skipped snapshot numbers summed over all clients in a 10~s window. Ping is the Godot client's ping proxy, not a true round trip. Dashed lines: 20 snapshots per second and the 18~Hz tick threshold. Clients responding was 100\% throughout and the median server tick rate stayed between 19.9 and 20.1~Hz for both servers (Table~\ref {tab:holdsum}), so those two panels are left out.\relax }{figure.caption.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Test 2, packet gaps (left) and latency (right) during the 20-minute hold at 180, 260, 270 and 300 clients. Each line is the median of 8 runs and the band spans the 25th to the 75th percentile. Gaps are skipped snapshot numbers summed over all clients in a 10\nobreakspace  {}s window.\relax }}{8}{figure.caption.16}\protected@file@percent }
\newlabel{fig:holdall}{{8}{8}{Test 2, packet gaps (left) and latency (right) during the 20-minute hold at 180, 260, 270 and 300 clients. Each line is the median of 8 runs and the band spans the 25th to the 75th percentile. Gaps are skipped snapshot numbers summed over all clients in a 10~s window.\relax }{figure.caption.16}{}}
\@writefile{lot}{\contentsline {table}{\numberline {IX}{\ignorespaces Hold results at each target, from the 8 runs (C++ server with Godot clients; ENet server with ENet clients). Each run is first averaged over its 20-minute hold. Ping shows the median of the 8 run averages with the standard deviation in brackets. Gaps = skipped snapshot numbers summed over all clients and the whole hold: median with the lowest and highest run in brackets; ``\% of exp.'' is the median divided by the snapshots expected (clients $\times $ 20 per second $\times $ 1200\nobreakspace  {}s). Cert.\ = certainty (percent) from the 8 run values: one minus the normalized fractional uncertainty (coefficient of variation divided by $\sqrt  {8}$) raised to the scaling factor 0.4; n/a where the median is 0. Tick err.\ = absolute fractional error of the mean server tick rate against the 20\nobreakspace  {}Hz baseline. Every run at every target responded at 100\% and received 20 snapshots per client per second (19.96 to 20.00). A run ``held'' if its hold averages met the health limits (at least 99\% responding, at least 18 snapshots per second, ping at most 150\nobreakspace  {}ms, tick at least 18\nobreakspace  {}Hz).\relax }}{8}{table.caption.17}\protected@file@percent }
\newlabel{tab:holdsum}{{IX}{8}{Hold results at each target, from the 8 runs (C++ server with Godot clients; ENet server with ENet clients). Each run is first averaged over its 20-minute hold. Ping shows the median of the 8 run averages with the standard deviation in brackets. Gaps = skipped snapshot numbers summed over all clients and the whole hold: median with the lowest and highest run in brackets; ``\% of exp.'' is the median divided by the snapshots expected (clients $\times $ 20 per second $\times $ 1200~s). Cert.\ = certainty (percent) from the 8 run values: one minus the normalized fractional uncertainty (coefficient of variation divided by $\sqrt {8}$) raised to the scaling factor 0.4; n/a where the median is 0. Tick err.\ = absolute fractional error of the mean server tick rate against the 20~Hz baseline. Every run at every target responded at 100\% and received 20 snapshots per client per second (19.96 to 20.00). A run ``held'' if its hold averages met the health limits (at least 99\% responding, at least 18 snapshots per second, ping at most 150~ms, tick at least 18~Hz).\relax }{table.caption.17}{}}
