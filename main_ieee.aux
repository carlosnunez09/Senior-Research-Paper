\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces The fixed-timestep tick schedule in the C++ server (excerpt from \texttt  {server/main.cpp}). The key change is \texttt  {next\_tick += tick\_period}: the next tick is due one period after the previous due time, not after the moment the tick was noticed.\relax }}{4}{figure.caption.11}\protected@file@percent }
\newlabel{lst:fixed}{{5}{4}{The fixed-timestep tick schedule in the C++ server (excerpt from \texttt {server/main.cpp}). The key change is \texttt {next\_tick += tick\_period}: the next tick is due one period after the previous due time, not after the moment the tick was noticed.\relax }{figure.caption.11}{}}
