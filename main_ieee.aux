\@writefile{lot}{\contentsline {table}{\numberline {III}{\ignorespaces The three main measures, and the tick-rate warning sign. All other collected data supports them.\relax }}{3}{table.caption.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Where a test runs. The runner creates one server VM and three client VMs, starts the server, tells each client VM how many bots to run, and downloads the results afterwards. The bots and the server talk to each other over the cloud's private network (a switch). Each client VM runs about a third of the bots, so the server sees all of them as one crowd.\relax }}{3}{figure.caption.7}\protected@file@percent }
\newlabel{fig:fleet}{{4}{3}{Where a test runs. The runner creates one server VM and three client VMs, starts the server, tells each client VM how many bots to run, and downloads the results afterwards. The bots and the server talk to each other over the cloud's private network (a switch). Each client VM runs about a third of the bots, so the server sees all of them as one crowd.\relax }{figure.caption.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {IV}{\ignorespaces Granularity of each measured quantity. The precision limit of a conclusion is set by the coarsest quantity it relies on.\relax }}{3}{table.caption.8}\protected@file@percent }
\newlabel{tab:precision}{{IV}{3}{Granularity of each measured quantity. The precision limit of a conclusion is set by the coarsest quantity it relies on.\relax }{table.caption.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {V}{\ignorespaces Runs used in the results. The progressive ladder is eight complete runs per backend, each run a separate pass from 1 to 300 clients (one repetition each). The C++ server is driven by Godot UDP clients and the ENet server by Godot ENet clients. The hold tests are eight runs per backend and target, each a 20-minute hold (one repetition each) after a ramp-up of 10 clients per 10\nobreakspace  {}s.\relax }}{4}{table.caption.9}\protected@file@percent }
