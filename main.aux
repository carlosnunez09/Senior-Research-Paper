\@writefile{toc}{\contentsline {subsection}{\numberline {8.1}Test 1, progressive ladder: granular runs (both patches applied)}{18}{subsection.8.1}\protected@file@percent }
\newlabel{sec:ladder}{{8.1}{18}{Test 1, progressive ladder: granular runs (both patches applied)}{subsection.8.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {21}{\ignorespaces Test 1, progressive ladder (granular batch, both patches applied; server on an e2-standard-2 VM, three n2-standard-4 client VMs, 10\nobreakspace  {}s per client count; the 1-client warm-up state is left out). Each line is the mean of 8 runs and the band spans the lowest to the highest run. Ping is measured by the Godot client (time from its last send until a snapshot arrives), not a true round trip. Packet gaps are skipped snapshot numbers summed over all clients in a state. Dashed lines: 20 snapshots per second and the 18\nobreakspace  {}Hz tick threshold.}}{19}{figure.21}\protected@file@percent }
\newlabel{fig:ladder}{{21}{19}{Test 1, progressive ladder (granular batch, both patches applied; server on an e2-standard-2 VM, three n2-standard-4 client VMs, 10~s per client count; the 1-client warm-up state is left out). Each line is the mean of 8 runs and the band spans the lowest to the highest run. Ping is measured by the Godot client (time from its last send until a snapshot arrives), not a true round trip. Packet gaps are skipped snapshot numbers summed over all clients in a state. Dashed lines: 20 snapshots per second and the 18~Hz tick threshold}{figure.21}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Ladder results at selected client counts, summed up over 8 runs (10\nobreakspace  {}s per state). Ping, Snap/s and Gaps show the mean and, in brackets, the lowest and highest run. Resp.\ = clients responding (mean); Ping = the Godot client's ping proxy; Snap/s = snapshots received per client per second; Gaps = skipped snapshot numbers in that state; Tick = server ticks per second; Srv CPU = server CPU.}}{20}{table.8}\protected@file@percent }
\newlabel{tab:ladder}{{8}{20}{Ladder results at selected client counts, summed up over 8 runs (10~s per state). Ping, Snap/s and Gaps show the mean and, in brackets, the lowest and highest run. Resp.\ = clients responding (mean); Ping = the Godot client's ping proxy; Snap/s = snapshots received per client per second; Gaps = skipped snapshot numbers in that state; Tick = server ticks per second; Srv CPU = server CPU}{table.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Per run, over the whole ladder (292 states): states that met the health limits, snapshot gaps summed over all states, and the first client count (from 10 upward) at which a state failed (-- = none).}}{20}{table.9}\protected@file@percent }
\newlabel{tab:limit}{{9}{20}{Per run, over the whole ladder (292 states): states that met the health limits, snapshot gaps summed over all states, and the first client count (from 10 upward) at which a state failed (-- = none)}{table.9}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.2}Test 2, hold at 300 clients}{20}{subsection.8.2}\protected@file@percent }
\newlabel{sec:hold300}{{8.2}{20}{Test 2, hold at 300 clients}{subsection.8.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.3}Test 2, hold at every target}{20}{subsection.8.3}\protected@file@percent }
\newlabel{sec:holdall}{{8.3}{20}{Test 2, hold at every target}{subsection.8.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {22}{\ignorespaces Test 2, hold at 300 clients (server on an e2-standard-2 VM, three n2-standard-4 client VMs). The clients are added first (ramp-up, 10 clients every 10\nobreakspace  {}s) and the plot starts when the last client has joined; it then covers the 20-minute hold with no new clients. Each line is the mean of 8 runs and the band spans the lowest to the highest run. Packet gaps are skipped snapshot numbers summed over all clients in a 10\nobreakspace  {}s window. Ping is the Godot client's ping proxy, not a true round trip. Dashed lines: 20 snapshots per second and the 18\nobreakspace  {}Hz tick threshold.}}{21}{figure.22}\protected@file@percent }
\newlabel{fig:hold300}{{22}{21}{Test 2, hold at 300 clients (server on an e2-standard-2 VM, three n2-standard-4 client VMs). The clients are added first (ramp-up, 10 clients every 10~s) and the plot starts when the last client has joined; it then covers the 20-minute hold with no new clients. Each line is the mean of 8 runs and the band spans the lowest to the highest run. Packet gaps are skipped snapshot numbers summed over all clients in a 10~s window. Ping is the Godot client's ping proxy, not a true round trip. Dashed lines: 20 snapshots per second and the 18~Hz tick threshold}{figure.22}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {23}{\ignorespaces Test 2, packet gaps (left) and latency (right) during the 20-minute hold at 180, 260, 270 and 300 clients. Each line is the mean of 8 runs and the band spans the lowest to the highest run. Gaps are skipped snapshot numbers summed over all clients in a 10\nobreakspace  {}s window.}}{22}{figure.23}\protected@file@percent }
\newlabel{fig:holdall}{{23}{22}{Test 2, packet gaps (left) and latency (right) during the 20-minute hold at 180, 260, 270 and 300 clients. Each line is the mean of 8 runs and the band spans the lowest to the highest run. Gaps are skipped snapshot numbers summed over all clients in a 10~s window}{figure.23}{}}
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces Hold results at each target, summed up over 8 runs. Each run is first averaged over its 20-minute hold; the table gives the mean of those averages and, in brackets for Ping and Gaps, the lowest and highest run. Gaps = skipped snapshot numbers summed over all clients and the whole hold. Resp. = clients responding, Snap/s = snapshots received per client per second, Tick = server ticks per second, CPU = server CPU. A run ``held'' if its hold averages met the health limits (at least 99\% responding, at least 18 snapshots per second, ping at most 150\nobreakspace  {}ms, tick at least 18\nobreakspace  {}Hz).}}{23}{table.10}\protected@file@percent }
\newlabel{tab:holdsum}{{10}{23}{Hold results at each target, summed up over 8 runs. Each run is first averaged over its 20-minute hold; the table gives the mean of those averages and, in brackets for Ping and Gaps, the lowest and highest run. Gaps = skipped snapshot numbers summed over all clients and the whole hold. Resp. = clients responding, Snap/s = snapshots received per client per second, Tick = server ticks per second, CPU = server CPU. A run ``held'' if its hold averages met the health limits (at least 99\% responding, at least 18 snapshots per second, ping at most 150~ms, tick at least 18~Hz)}{table.10}{}}
