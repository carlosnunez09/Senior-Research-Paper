\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Server and client side by side (redrawn). The server keeps every player in a table (a Godot Dictionary, id $\rightarrow $ position and goal). Every tick it packs the table into bytes and sends it. Each client unpacks the bytes into its own table of the same name and draws it, so the two screens show the same players and follow each other, about one network trip apart. The client's only extra is the white outline on its own square. Going the other way, each client sends only its own row.\relax }}{6}{figure.caption.9}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces How one snapshot is packed (ENet backend, default binary format). The server writes the header and then one 12-byte block per player into one byte array with \texttt  {encode\_u32}/\texttt  {encode\_u16} and sends it as a remote procedure call. The client reads the same positions back with \texttt  {decode\_u32}/\texttt  {decode\_u16}. The alternative \texttt  {--enet-snapshot=variant} sends the same rows as a list of dictionaries, with the keys \texttt  {id, x, y, gx, gy} sent as text each time.\relax }}{6}{figure.caption.10}\protected@file@percent }
\newlabel{fig:snapshot}{{7}{6}{How one snapshot is packed (ENet backend, default binary format). The server writes the header and then one 12-byte block per player into one byte array with \texttt {encode\_u32}/\texttt {encode\_u16} and sends it as a remote procedure call. The client reads the same positions back with \texttt {decode\_u32}/\texttt {decode\_u16}. The alternative \texttt {--enet-snapshot=variant} sends the same rows as a list of dictionaries, with the keys \texttt {id, x, y, gx, gy} sent as text each time.\relax }{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Main loop of the C++ server. It repeats forever on one thread.\relax }}{6}{figure.caption.15}\protected@file@percent }
\newlabel{fig:cppflow}{{10}{6}{Main loop of the C++ server. It repeats forever on one thread.\relax }{figure.caption.15}{}}
\newlabel{fig:cppLoop}{{10}{6}{Main loop of the C++ server. It repeats forever on one thread.\relax }{figure.caption.15}{}}
