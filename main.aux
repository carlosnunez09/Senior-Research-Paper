\newlabel{fig:cppLoop}{{8}{7}{Main loop of the C++ server. It repeats forever on one thread}{figure.8}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5}How Both Servers Work: The Ins and Outs}{7}{section.5}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces The two backends side by side.}}{8}{table.3}\protected@file@percent }
\newlabel{tab:compare}{{3}{8}{The two backends side by side}{table.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces What the player and the server say to each other. The player says where it is, the server replies with where everyone is, and this repeats 20 times a second. Ping is how long it takes to hear back; a lost reply shows up as a missing number. The ENet backend does the same thing through Godot's own networking.}}{8}{figure.9}\protected@file@percent }
\newlabel{fig:flow}{{9}{8}{What the player and the server say to each other. The player says where it is, the server replies with where everyone is, and this repeats 20 times a second. Ping is how long it takes to hear back; a lost reply shows up as a missing number. The ENet backend does the same thing through Godot's own networking}{figure.9}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.1}One tick, step by step}{9}{subsection.5.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces The server tick. Steps 1 to 4 are the work; step 5 is spare time. The more clients there are, the longer steps 3 and 4 take.}}{9}{figure.10}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}Why more clients means much more work}{9}{subsection.5.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Data the server must send each second as clients are added (calculated from the packet format; ENet is similar). Tripling the clients from 100 to 300 multiplies the data about nine times.}}{9}{figure.11}\protected@file@percent }
\newlabel{fig:growth}{{11}{9}{Data the server must send each second as clients are added (calculated from the packet format; ENet is similar). Tripling the clients from 100 to 300 multiplies the data about nine times}{figure.11}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}How clients end up responding less (and recovering)}{9}{subsection.5.3}\protected@file@percent }
\newlabel{sec:chain}{{5.3}{9}{How clients end up responding less (and recovering)}{subsection.5.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Left: a server that keeps up. Right: how adding clients leads to fewer clients responding. The dashed arrows show that removing load reverses it.}}{10}{figure.12}\protected@file@percent }
\newlabel{fig:chain}{{12}{10}{Left: a server that keeps up. Right: how adding clients leads to fewer clients responding. The dashed arrows show that removing load reverses it}{figure.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces What one client receives over 500\nobreakspace  {}ms (schematic). Each dot is a snapshot the server should send every 50\nobreakspace  {}ms. Healthy: all arrive on time. Struggling: some come late and bunched together, others never arrive. Not responding: none arrive, so the client is counted as not responding.}}{10}{figure.13}\protected@file@percent }
\newlabel{fig:arrivals}{{13}{10}{What one client receives over 500~ms (schematic). Each dot is a snapshot the server should send every 50~ms. Healthy: all arrive on time. Struggling: some come late and bunched together, others never arrive. Not responding: none arrive, so the client is counted as not responding}{figure.13}{}}
