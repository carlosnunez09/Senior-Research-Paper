\@writefile{toc}{\contentsline {subsection}{\numberline {6.3}How the data is collected}{9}{subsection.6.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Where a test runs. The runner on your computer creates one server VM and three client VMs, starts the server, tells each client VM how many bots to run, and downloads the results afterwards. The bots and the server talk to each other over the cloud's private network (a switch). Each client VM runs about a third of the bots, so the server sees all of them as one crowd.}}{10}{figure.10}\protected@file@percent }
\newlabel{fig:fleet}{{10}{10}{Where a test runs. The runner on your computer creates one server VM and three client VMs, starts the server, tells each client VM how many bots to run, and downloads the results afterwards. The bots and the server talk to each other over the cloud's private network (a switch). Each client VM runs about a third of the bots, so the server sees all of them as one crowd}{figure.10}{}}
