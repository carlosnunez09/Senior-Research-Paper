\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Where a test runs. The runner on your computer creates one server VM and three client VMs, starts the server, tells each client VM how many bots to run, and downloads the results afterwards. The bots and the server talk to each other over the cloud's private network (a switch). Each client VM runs about a third of the bots, so the server sees all of them as one crowd.}}{13}{figure.15}\protected@file@percent }
\newlabel{fig:fleet}{{15}{13}{Where a test runs. The runner on your computer creates one server VM and three client VMs, starts the server, tells each client VM how many bots to run, and downloads the results afterwards. The bots and the server talk to each other over the cloud's private network (a switch). Each client VM runs about a third of the bots, so the server sees all of them as one crowd}{figure.15}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.6}Runs}{14}{subsection.6.6}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Runs used in the results. The progressive ladder is eight complete runs per backend, each run a separate pass from 1 to 300 clients (one repetition each). The C++ server is driven by Godot UDP clients and the ENet server by Godot ENet clients. The hold tests are eight runs per backend and target, each a 20-minute hold (one repetition each) after a ramp-up of 10 clients per 10\nobreakspace  {}s.}}{14}{table.5}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {7}Problems Found in the First Runs, and How They Were Fixed}{14}{section.7}\protected@file@percent }
\newlabel{sec:fixes}{{7}{14}{Problems Found in the First Runs, and How They Were Fixed}{section.7}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {7.1}Overview}{14}{subsection.7.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces The problems found in the first runs.}}{14}{table.6}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {7.2}Problem 1: the C++ tick drifted below 20\nobreakspace  {}Hz}{14}{subsection.7.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\numberline {7.2.1}What we saw}{14}{subsubsection.7.2.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\numberline {7.2.2}Why it happened: the stopwatch}{14}{subsubsection.7.2.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\numberline {7.2.3}The drift in one picture}{15}{subsubsection.7.2.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces Counting ticks, C++ against ENet (schematic, each tick noticed 2\nobreakspace  {}ms late). Every dot is one tick and the number is the tick count. The C++ loop restarts its stopwatch at each tick, so its ticks are 52\nobreakspace  {}ms apart and it has counted only 19 ticks after one second. The Godot timer keeps its 50\nobreakspace  {}ms timetable, so its tick 20 arrives at exactly 1000\nobreakspace  {}ms. After 10 ticks the C++ server is already 20\nobreakspace  {}ms behind, and the gap keeps growing.}}{15}{figure.16}\protected@file@percent }
\newlabel{fig:drift}{{16}{15}{Counting ticks, C++ against ENet (schematic, each tick noticed 2~ms late). Every dot is one tick and the number is the tick count. The C++ loop restarts its stopwatch at each tick, so its ticks are 52~ms apart and it has counted only 19 ticks after one second. The Godot timer keeps its 50~ms timetable, so its tick 20 arrives at exactly 1000~ms. After 10 ticks the C++ server is already 20~ms behind, and the gap keeps growing}{figure.16}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {7.2.4}A worked example}{15}{subsubsection.7.2.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\numberline {7.2.5}The code behind it}{15}{subsubsection.7.2.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces The tick check in the C++ server and the one-line change that would remove the drift.}}{16}{figure.17}\protected@file@percent }
\newlabel{lst:tick}{{17}{16}{The tick check in the C++ server and the one-line change that would remove the drift}{figure.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces Pseudocode for the two ways of timing a tick. Think of a bus that should leave every 50 minutes: the stopwatch driver restarts his watch whenever he notices the bus is due, so any lateness is kept; the timetable driver follows fixed times, so lateness is not kept.}}{16}{figure.18}\protected@file@percent }
\newlabel{lst:pseudo}{{18}{16}{Pseudocode for the two ways of timing a tick. Think of a bus that should leave every 50 minutes: the stopwatch driver restarts his watch whenever he notices the bus is due, so any lateness is kept; the timetable driver follows fixed times, so lateness is not kept}{figure.18}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {7.2.6}The fix}{16}{subsubsection.7.2.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {19}{\ignorespaces The fixed-timestep tick schedule in the C++ server (excerpts from \texttt  {server/main.cpp}). The key change is \texttt  {next\_tick += tick\_period}: the next tick is due one period after the previous due time, not after the moment the tick was noticed.}}{17}{figure.19}\protected@file@percent }
\newlabel{lst:fixed}{{19}{17}{The fixed-timestep tick schedule in the C++ server (excerpts from \texttt {server/main.cpp}). The key change is \texttt {next\_tick += tick\_period}: the next tick is due one period after the previous due time, not after the moment the tick was noticed}{figure.19}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {20}{\ignorespaces The old and the fixed tick loop side by side (simplified from Figures\nobreakspace  {}\ref  {lst:tick} and\nobreakspace  {}\ref  {lst:fixed}). The red line is the one that causes the drift: it restarts the stopwatch at the moment the tick was noticed. The green lines schedule the next tick from the previous due time, and resynchronize if the server falls a whole tick behind.}}{17}{figure.20}\protected@file@percent }
\newlabel{lst:diff}{{20}{17}{The old and the fixed tick loop side by side (simplified from Figures~\ref {lst:tick} and~\ref {lst:fixed}). The red line is the one that causes the drift: it restarts the stopwatch at the moment the tick was noticed. The green lines schedule the next tick from the previous due time, and resynchronize if the server falls a whole tick behind}{figure.20}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {7.2.7}Result of the fix}{17}{subsubsection.7.2.7}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {7.3}Problem 2: snapshots of different size}{18}{subsection.7.3}\protected@file@percent }
