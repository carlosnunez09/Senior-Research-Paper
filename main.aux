\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Runs used in the results. The progressive ladder is eight complete runs per backend, each run a separate pass from 1 to 300 clients (one repetition each). Each hold target is also eight runs; the ENet captures that runs 3 and 4 were missing were repeated in a separate make-up batch.}}{11}{table.5}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {7}Problems Found in the First Runs, and How They Were Fixed}{11}{section.7}\protected@file@percent }
\newlabel{sec:fixes}{{7}{11}{Problems Found in the First Runs, and How They Were Fixed}{section.7}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {7.1}Overview}{12}{subsection.7.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces The problems found in the first runs.}}{12}{table.6}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {7.2}Problem 1: the C++ tick drifted below 20~Hz}{12}{subsection.7.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\numberline {7.2.1}What we saw}{12}{subsubsection.7.2.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\numberline {7.2.2}Why it happened: the stopwatch}{12}{subsubsection.7.2.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\numberline {7.2.3}The drift in one picture}{12}{subsubsection.7.2.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Counting ticks, C++ against ENet (schematic, each tick noticed 2~ms late). Every dot is one tick and the number is the tick count. The C++ loop restarts its stopwatch at each tick, so its ticks are 52~ms apart and it has counted only 19 ticks after one second. The Godot timer keeps its 50~ms timetable, so its tick 20 arrives at exactly 1000~ms. After 10 ticks the C++ server is already 20~ms behind, and the gap keeps growing.}}{13}{figure.11}\protected@file@percent }
\newlabel{fig:drift}{{11}{13}{Counting ticks, C++ against ENet (schematic, each tick noticed 2~ms late). Every dot is one tick and the number is the tick count. The C++ loop restarts its stopwatch at each tick, so its ticks are 52~ms apart and it has counted only 19 ticks after one second. The Godot timer keeps its 50~ms timetable, so its tick 20 arrives at exactly 1000~ms. After 10 ticks the C++ server is already 20~ms behind, and the gap keeps growing}{figure.11}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {7.2.4}A worked example}{13}{subsubsection.7.2.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\numberline {7.2.5}The code behind it}{13}{subsubsection.7.2.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces The tick check in the C++ server and the one-line change that would remove the drift.}}{13}{figure.12}\protected@file@percent }
\newlabel{lst:tick}{{12}{13}{The tick check in the C++ server and the one-line change that would remove the drift}{figure.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Pseudocode for the two ways of timing a tick. Think of a bus that should leave every 50 minutes: the stopwatch driver restarts his watch whenever he notices the bus is due, so any lateness is kept; the timetable driver follows fixed times, so lateness is not kept.}}{14}{figure.13}\protected@file@percent }
\newlabel{lst:pseudo}{{13}{14}{Pseudocode for the two ways of timing a tick. Think of a bus that should leave every 50 minutes: the stopwatch driver restarts his watch whenever he notices the bus is due, so any lateness is kept; the timetable driver follows fixed times, so lateness is not kept}{figure.13}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {7.2.6}The fix}{14}{subsubsection.7.2.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces The fixed-timestep tick schedule in the C++ server (excerpts from \texttt  {server/main.cpp}). The key change is \texttt  {next\_tick += tick\_period}: the next tick is due one period after the previous due time, not after the moment the tick was noticed.}}{14}{figure.14}\protected@file@percent }
\newlabel{lst:fixed}{{14}{14}{The fixed-timestep tick schedule in the C++ server (excerpts from \texttt {server/main.cpp}). The key change is \texttt {next\_tick += tick\_period}: the next tick is due one period after the previous due time, not after the moment the tick was noticed}{figure.14}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {7.2.7}Result of the fix}{15}{subsubsection.7.2.7}\protected@file@percent }
