\newlabel{tab:terms}{{1}{2}{Terms used in this paper}{table.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Schematic of a server tick (illustrative timings, not measured data). Each tick the server receives client input, updates the world, and sends a snapshot; at 20\nobreakspace  {}Hz it has 50\nobreakspace  {}ms for all of it. If the work per tick grows with the number of clients and passes 50\nobreakspace  {}ms (panel\nobreakspace  {}C), the snapshot still leaves at the 50\nobreakspace  {}ms deadline, because the next tick's work has to start. The tick rate therefore stays near 20\nobreakspace  {}Hz, but the work is unfinished, so the snapshots carry less up-to-date information and clients see worse ping and more gaps.}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:tickvisual}{{1}{2}{Schematic of a server tick (illustrative timings, not measured data). Each tick the server receives client input, updates the world, and sends a snapshot; at 20~Hz it has 50~ms for all of it. If the work per tick grows with the number of clients and passes 50~ms (panel~C), the snapshot still leaves at the 50~ms deadline, because the next tick's work has to start. The tick rate therefore stays near 20~Hz, but the work is unfinished, so the snapshots carry less up-to-date information and clients see worse ping and more gaps}{figure.1}{}}
\@writefile{toc}{\contentsline {section}{\numberline {3}Making of the Godot Client and ENet Server}{3}{section.3}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Notes from the code (delete when written).}{3}{section*.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The Godot project. One script is started in different modes. A UDP client talks to the separate C++ server; an ENet client talks to the same project started as an ENet server.}}{3}{figure.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces The Godot client the moment it joins (a redrawing of the NodeStrike window). The board is the 20×20 grid; the only player in view is the client's own.}}{4}{figure.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces The running NodeStrike client (redrawn from a screenshot of a client started in a window; headless benchmark clients draw nothing). Each tick every bot moves one tile toward its goal. The server's snapshot tells each client where every other player is; the client only draws it. Each player's pale hollow square is that player's goal.}}{4}{figure.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Server and client side by side (redrawn). The server keeps every player in a table (a Godot Dictionary, id $\rightarrow $ position and goal). Every tick it packs the table into bytes and sends it. Each client unpacks the bytes into its own table of the same name and draws it, so the two screens show the same players and follow each other, about one network trip apart. The client's only extra is the white outline on its own square. Going the other way, each client sends only its own row.}}{5}{figure.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces How one snapshot is packed (ENet backend, default binary format). The server writes the header and then one 12-byte block per player into one byte array with \texttt  {encode\_u32}/\texttt  {encode\_u16} and sends it as a remote procedure call. The client reads the same positions back with \texttt  {decode\_u32}/\texttt  {decode\_u16}. The alternative \texttt  {--enet-snapshot=variant} sends the same rows as a list of dictionaries, with the keys \texttt  {id, x, y, gx, gy} sent as text each time.}}{5}{figure.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \leavevmode {\color  {red!70!black}\textbf  {[DRAFT]}}{} The ENet server packs the player table into one byte array and sends it to every client (excerpt of \texttt  {main.gd}, constants written out as numbers and the statistics counter left out).}}{6}{figure.7}\protected@file@percent }
