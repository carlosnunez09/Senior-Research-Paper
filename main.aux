\@writefile{lof}{\contentsline {figure}{\numberline {20}{\ignorespaces The tick check in the C++ server and the one-line change that removes the drift.\relax }}{11}{figure.caption.30}\protected@file@percent }
\newlabel{lst:tick}{{20}{11}{The tick check in the C++ server and the one-line change that removes the drift.\relax }{figure.caption.30}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {6}The fix}{11}{subsubsection.7.2.6}\protected@file@percent }
\newlabel{sec:thefix}{{VII-B6}{11}{The fix}{subsubsection.7.2.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {22}{\ignorespaces The fixed-timestep tick schedule in the C++ server (excerpts from \texttt  {server/main.cpp}). The key change is \texttt  {next\_tick += tick\_period}: the next tick is due one period after the previous due time, not after the moment the tick was noticed.\relax }}{11}{figure.caption.32}\protected@file@percent }
\newlabel{lst:fixed}{{22}{11}{The fixed-timestep tick schedule in the C++ server (excerpts from \texttt {server/main.cpp}). The key change is \texttt {next\_tick += tick\_period}: the next tick is due one period after the previous due time, not after the moment the tick was noticed.\relax }{figure.caption.32}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {7}Result of the fix}{11}{subsubsection.7.2.7}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {C}Problem 2: snapshots of different size}{11}{subsection.7.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {19}{\ignorespaces Counting ticks, C++ against ENet (schematic, each tick noticed 2\nobreakspace  {}ms late). Every dot is one tick and the number is the tick count. The C++ loop restarts its stopwatch at each tick, so its ticks are 52\nobreakspace  {}ms apart and it has counted only 19 ticks after one second. The Godot timer keeps its 50\nobreakspace  {}ms timetable, so its tick 20 arrives at exactly 1000\nobreakspace  {}ms. After 10 ticks the C++ server is already 20\nobreakspace  {}ms behind, and the gap keeps growing.\relax }}{12}{figure.caption.29}\protected@file@percent }
\newlabel{fig:drift}{{19}{12}{Counting ticks, C++ against ENet (schematic, each tick noticed 2~ms late). Every dot is one tick and the number is the tick count. The C++ loop restarts its stopwatch at each tick, so its ticks are 52~ms apart and it has counted only 19 ticks after one second. The Godot timer keeps its 50~ms timetable, so its tick 20 arrives at exactly 1000~ms. After 10 ticks the C++ server is already 20~ms behind, and the gap keeps growing.\relax }{figure.caption.29}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {21}{\ignorespaces Pseudocode for the two ways of timing a tick. Think of a bus that should leave every 50 minutes: the stopwatch driver restarts his watch whenever he notices the bus is due, so any lateness is kept; the timetable driver follows fixed times, so lateness is not kept.\relax }}{12}{figure.caption.31}\protected@file@percent }
\newlabel{lst:pseudo}{{21}{12}{Pseudocode for the two ways of timing a tick. Think of a bus that should leave every 50 minutes: the stopwatch driver restarts his watch whenever he notices the bus is due, so any lateness is kept; the timetable driver follows fixed times, so lateness is not kept.\relax }{figure.caption.31}{}}
