\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces What the player and the server say to each other. The player says where it is, the server replies with where everyone is, and this repeats 20 times a second. Ping is how long it takes to hear back; a lost reply shows up as a missing number. The ENet backend does the same thing through Godot's own networking.}}{6}{figure.4}\protected@file@percent }
\newlabel{fig:flow}{{4}{6}{What the player and the server say to each other. The player says where it is, the server replies with where everyone is, and this repeats 20 times a second. Ping is how long it takes to hear back; a lost reply shows up as a missing number. The ENet backend does the same thing through Godot's own networking}{figure.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.1}One tick, step by step}{6}{subsection.5.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces The server tick. Steps 1 to 4 are the work; step 5 is spare time. The more clients there are, the longer steps 3 and 4 take.}}{6}{figure.5}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}Why more clients means much more work}{7}{subsection.5.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Data the server must send each second as clients are added (calculated from the packet format; ENet is similar). Tripling the clients from 100 to 300 multiplies the data about nine times.}}{7}{figure.6}\protected@file@percent }
\newlabel{fig:growth}{{6}{7}{Data the server must send each second as clients are added (calculated from the packet format; ENet is similar). Tripling the clients from 100 to 300 multiplies the data about nine times}{figure.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}How clients end up responding less (and recovering)}{7}{subsection.5.3}\protected@file@percent }
\newlabel{sec:chain}{{5.3}{7}{How clients end up responding less (and recovering)}{subsection.5.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Left: a server that keeps up. Right: how adding clients leads to fewer clients responding. The dashed arrows show that removing load reverses it.}}{7}{figure.7}\protected@file@percent }
\newlabel{fig:chain}{{7}{7}{Left: a server that keeps up. Right: how adding clients leads to fewer clients responding. The dashed arrows show that removing load reverses it}{figure.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces What one client receives over 500~ms (schematic). Each dot is a snapshot the server should send every 50~ms. Healthy: all arrive on time. Struggling: some come late and bunched together, others never arrive. Not responding: none arrive, so the client is counted as not responding.}}{8}{figure.8}\protected@file@percent }
\newlabel{fig:arrivals}{{8}{8}{What one client receives over 500~ms (schematic). Each dot is a snapshot the server should send every 50~ms. Healthy: all arrive on time. Struggling: some come late and bunched together, others never arrive. Not responding: none arrive, so the client is counted as not responding}{figure.8}{}}
